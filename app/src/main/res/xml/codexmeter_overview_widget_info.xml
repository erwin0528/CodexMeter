<?xml version="1.0" encoding="utf-8"?>
<!-- 多帳號總覽：預設 4×2（約 4 個帳號），可拉到 4×4 放更多列；最小 3×1 只顯示一列。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/overview_widget_description"
    android:initialLayout="@layout/codexmeter_widget_loading"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="420dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
